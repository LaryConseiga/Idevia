# Copier en .env.local (développement) ou saisir dans les variables d'environnement Vercel.
# Ne jamais committer de vraie valeur.

APP_URL=http://localhost:3000

# Neon : écrites par `neon deploy` / `neon env pull` (rôle propriétaire neondb_owner, qui a BYPASSRLS).
# Elles ne servent qu'aux migrations.
DATABASE_URL=postgresql://neondb_owner:...@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:...@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Rôle applicatif sans BYPASSRLS, utilisé par l'application : `npm run db:app-role` le crée et remplit cette ligne.
DATABASE_APP_URL=postgresql://idevia_app:...@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BETTER_AUTH_SECRET=
# Clés AES-256 (32 octets en base64). Rotation : ajouter ",v2:..." en fin de liste.
DATA_ENCRYPTION_KEYS=v1:
ANALYTICS_SALT=

# Emails (Resend, plan gratuit)
RESEND_API_KEY=
EMAIL_FROM="Idevia <bonjour@ton-domaine>"

# Rate limiting (Upstash Redis, plan gratuit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Modèles IA (offres gratuites)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# Optionnel : changer de modèle sans modifier le code (valeurs par défaut dans src/server/env.ts)
# AI_MODEL_GROQ_FAST=qwen/qwen3.8-27b
# AI_MODEL_GROQ_REASONING=openai/gpt-oss-120b
# AI_MODEL_GEMINI=gemini-3.5-flash
# AI_MODEL_GEMINI_LITE=gemini-3.5-flash-lite
# AI_MODEL_OPENROUTER=nvidia/nemotron-3-ultra-550b-a55b:free
# AI_MODEL_CEREBRAS=gpt-oss-120b
# AI_MODEL_MISTRAL=ministral-8b-latest

# Signaux de marché (Apify, crédits gratuits mensuels)
APIFY_TOKEN=
# Vérifications terrain par mois et par compte (≈ 0,10 $ chacune hors cache ; défaut 2)
# FIELD_CHECKS_MONTHLY_QUOTA=2

# Idées : offre payante (on/off, désactivée au lancement) et générations par mois et par compte
IDEAS_PAYWALL=off
IDEAS_MONTHLY_QUOTA=3

# Tâches planifiées (purge des diagnostics anonymes expirés) : appelées avec "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
